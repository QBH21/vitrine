<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: the launcher makes no network calls and has no tracking. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the long-press "Uninstall" option open Android's own uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11 package visibility: the apps this launcher is allowed to list and open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- The Cast tile shows whether Chromecast built-in and the AirPlay receiver are on. -->
        <package android:name="com.google.android.apps.mediashell" />
        <package android:name="io.github.jqssun.airplay" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_home"
        android:label="Vitrine"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <!-- Home screen (only once you choose it; the stock launcher stays installed as a fallback) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed in the TV's app list, so it can be tried as a normal app first -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Brings Vitrine up whenever the stock launcher opens (see HomeRedirectService). -->
        <service
            android:name=".HomeRedirectService"
            android:exported="true"
            android:label="Vitrine home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_redirect" />
        </service>
    </application>
</manifest>
