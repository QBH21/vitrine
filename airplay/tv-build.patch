diff --git a/app/src/main/kotlin/io/github/jqssun/airplay/ui/TvScreen.kt b/app/src/main/kotlin/io/github/jqssun/airplay/ui/TvScreen.kt
new file mode 100644
index 0000000..4e73418
--- /dev/null
+++ b/app/src/main/kotlin/io/github/jqssun/airplay/ui/TvScreen.kt
@@ -0,0 +1,61 @@
+package io.github.jqssun.airplay.ui
+
+import android.view.Surface
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.text.BasicText
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import io.github.jqssun.airplay.viewmodel.MainViewModel
+
+/**
+ * The only screen used on the TV: black, with just the video surface. There's no status, settings or
+ * controls here - the receiver runs invisibly in the background, and this screen exists solely to show
+ * a mirrored or played video while a device is connected (the activity goes back to the home screen as
+ * soon as the session ends).
+ */
+@Composable
+fun TvScreen(
+    viewModel: MainViewModel,
+    onSurfaceAvailable: (Surface) -> Unit,
+    onSurfaceDestroyed: (Surface) -> Unit,
+) {
+    val videoPlayback by viewModel.videoPlaybackActive.collectAsState()
+    val mirrorAspect by viewModel.videoAspect.collectAsState()
+    val playbackAspect by viewModel.videoPlaybackAspect.collectAsState()
+    val pin by viewModel.pinCode.collectAsState()
+
+    Box(Modifier.fillMaxSize().background(Color.Black), contentAlignment = Alignment.Center) {
+        if (videoPlayback) {
+            // AirPlay video (a URL the sender hands over, e.g. from a video app)
+            VideoSurfaceView(
+                onSurfaceAvailable = { viewModel.onVideoPlaybackSurfaceAvailable(it) },
+                onSurfaceDestroyed = { viewModel.onVideoPlaybackSurfaceDestroyed(it) },
+                aspectRatio = playbackAspect,
+            )
+        } else {
+            // Screen mirroring; the surface is always present so the first frame has somewhere to go
+            VideoSurfaceView(
+                onSurfaceAvailable = onSurfaceAvailable,
+                onSurfaceDestroyed = onSurfaceDestroyed,
+                aspectRatio = mirrorAspect,
+            )
+        }
+        pin?.let {
+            BasicText(
+                "AirPlay code: $it",
+                Modifier.align(Alignment.TopCenter).padding(top = 48.dp),
+                style = TextStyle(color = Color.White, fontSize = 40.sp),
+            )
+        }
+    }
+}
